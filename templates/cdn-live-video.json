{
  "name": "cdn-live-video",
  "x": 5,
  "node_site_mapping": [
    {
      "k8s_node": "site-a",
      "site_name": "site-A"
    },
    {
      "k8s_node": "site-b",
      "site_name": "site-B"
    },
    {
      "k8s_node": "site-c",
      "site_name": "site-C"
    },
    {
      "k8s_node": "site-d",
      "site_name": "site-D"
    }
  ],
  "apps": {
    "camera-channel-a": {
      "cpu": { "a": 1, "b": 25 }, "ram": { "a": 0.1, "b": 64 }, "net": { "a": 0.5, "b": 8 },
      "placements": [
        { "site": "site-A", "count": 1 }
      ]
    },
    "camera-channel-b": {
      "cpu": { "a": 1, "b": 25 }, "ram": { "a": 0.1, "b": 64 }, "net": { "a": 0.5, "b": 8 },
      "placements": [
        { "site": "site-A", "count": 1 }
      ]
    },
    "transcoder": {
      "cpu": { "a": 6, "b": 120 }, "ram": { "a": 0.5, "b": 256 }, "net": { "a": 0.4, "b": 6 },
      "placements": [
        { "site": "site-A", "count": 2 }
      ]
    },
    "hls-packager": {
      "cpu": { "a": 2, "b": 50 }, "ram": { "a": 0.3, "b": 128 }, "net": { "a": 0.4, "b": 5 },
      "placements": [
        { "site": "site-A", "count": 1 }
      ]
    },
    "edge-cache": {
      "cpu": { "a": 1, "b": 40 }, "ram": { "a": 1, "b": 512 }, "net": { "a": 0.5, "b": 6 },
      "placements": [
        { "sites": ["site-B", "site-C"], "count": 1 }
      ]
    },
    "video-player": {
      "cpu": { "a": 0.5, "b": 20 }, "ram": { "a": 0.1, "b": 48 }, "net": { "a": 0, "b": 0 },
      "placements": [
        { "site": "site-D", "count": 1 }
      ]
    }
  },
  "network_links": [
    { "from": "site-A", "to": "site-B", "rtt_ms": 20, "bandwidth_mbps": 1000 },
    { "from": "site-A", "to": "site-C", "rtt_ms": 20, "bandwidth_mbps": 1000 },
    { "from": "site-B", "to": "site-D", "rtt_ms": 5,  "bandwidth_mbps": 500  },
    { "from": "site-C", "to": "site-D", "rtt_ms": 5,  "bandwidth_mbps": 500  }
  ],
  "edges": [
    { "from": "camera-channel-a", "to": "transcoder" },
    { "from": "camera-channel-b", "to": "transcoder" },
    { "from": "transcoder", "to": "hls-packager" },
    { "from": "hls-packager", "to": "edge-cache" },
    { "from": "edge-cache", "to": "video-player" }
  ],
  "runtime_scenarios": [
    { "phase_id": "preshow", "start_min": 0, "end_min": 10, "x": { "camera-channel-a": 5, "camera-channel-b": 5 } },
    { "phase_id": "channel_a_live", "start_min": 10, "end_min": 25, "x": { "camera-channel-a": 80, "camera-channel-b": 10 } },
    { "phase_id": "both_live", "start_min": 25, "end_min": 40, "x": { "camera-channel-a": 80, "camera-channel-b": 60 } },
    { "phase_id": "channel_b_only", "start_min": 40, "end_min": 55, "x": { "camera-channel-a": 5, "camera-channel-b": 90 } }
  ]
}
